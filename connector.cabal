cabal-version: 3.0
name: connector
version: 0.1.0.0
build-type: Simple
synopsis: Small EDN bridge from Haskell to Datomic Local
description: First-contact experiment with mandatory transaction attribution.
extra-source-files:
  README.md
  deps.edn
  bridge/src/connector/main.clj
  bridge/src/connector/attribution.edn
  experiment/*.edn
  experiment/MissingContext.hs
  experiment/refusal.py
  scripts/bridge
  scripts/install-local
  scripts/acceptance
  scripts/package-runtime
  test/runtime.py
  test/provision.py

data-files:
  deps.edn
  bridge/src/connector/main.clj
  bridge/src/connector/attribution.edn

library
  exposed-modules: Datomic.Connector, Datomic.Error, Datomic.EDN, Datomic.Runtime
  other-modules: Paths_connector
  autogen-modules: Paths_connector
  hs-source-dirs: src
  build-depends: base >=4.18 && <5, parsec, process, directory, filepath
  default-language: Haskell2010
  ghc-options: -Wall

executable first-contact
  main-is: Main.hs
  hs-source-dirs: experiment
  build-depends: base, connector
  default-language: Haskell2010
  ghc-options: -Wall -threaded

executable datomic-bridge
  main-is: Bridge.hs
  hs-source-dirs: app
  build-depends: base, connector, directory, process
  default-language: Haskell2010
  ghc-options: -Wall -threaded

test-suite connector-tests
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  build-depends: base, connector
  default-language: Haskell2010
  ghc-options: -Wall -threaded
