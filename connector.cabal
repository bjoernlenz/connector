cabal-version: 3.0
name: connector
version: 0.1.0.0
build-type: Simple
synopsis: Small EDN bridge from Haskell to Datomic Local
description:
  A subprocess bridge to Datomic Local with mandatory write attribution,
  lossless EDN scalar codecs, structured errors, typed transaction reports,
  and scoped consistent read snapshots. Includes portable bridge resources
  and an operational CLI for initializing project-owned databases.
category: Database
license: 0BSD
license-file: LICENSE
tested-with: GHC ==9.6.7

extra-source-files:
  README.md
  docs/how-to-start-a-new-project.md
  deps.edn
  bridge/src/connector/main.clj
  bridge/src/connector/attribution.edn
  experiment/*.edn
  experiment/MissingContext.hs
  experiment/refusal.py
  scripts/bridge
  scripts/install-local
  scripts/acceptance
  scripts/package-runtime
  test/runtime.py
  test/provision.py
  test/distribution.py
  test/clojure-startup.py
  scripts/check-metadata
  .github/workflows/ci.yml
  starter/connector-starter.cabal
  starter/cabal.project
  starter/README.md
  starter/LICENSE
  starter/db/*.edn
  starter/migrations/*.edn
  starter/src/Starter/*.hs
  starter/app/Main.hs
  starter/test/Main.hs

data-files:
  connector.cabal
  deps.edn
  bridge/src/connector/main.clj
  bridge/src/connector/attribution.edn

library
  exposed-modules: Datomic.Connector, Datomic.Error, Datomic.Report, Datomic.EDN, Datomic.Runtime
  other-modules: Paths_connector
  autogen-modules: Paths_connector
  hs-source-dirs: src
  build-depends: base >=4.18 && <5, parsec >=3.1.16 && <3.2,
    process >=1.6.19 && <1.7, directory >=1.3.8 && <1.4, filepath >=1.4.301 && <1.5,
    time >=1.12 && <1.15, containers >=0.6 && <0.8
  default-language: Haskell2010
  ghc-options: -Wall

executable first-contact
  main-is: Main.hs
  hs-source-dirs: experiment
  build-depends: base >=4.18 && <5, connector >=0.1 && <0.2
  default-language: Haskell2010
  ghc-options: -Wall -threaded

executable datomic-bridge
  main-is: Bridge.hs
  hs-source-dirs: app
  build-depends: base >=4.18 && <5, connector >=0.1 && <0.2,
    directory >=1.3.8 && <1.4, process >=1.6.19 && <1.7
  default-language: Haskell2010
  ghc-options: -Wall -threaded

test-suite connector-tests
  type: exitcode-stdio-1.0
  main-is: Main.hs
  other-modules: Paths_connector
  autogen-modules: Paths_connector
  hs-source-dirs: test
  build-depends: base >=4.18 && <5, connector >=0.1 && <0.2,
    directory >=1.3.8 && <1.4, time >=1.12 && <1.15
  default-language: Haskell2010
  ghc-options: -Wall -threaded

source-repository head
  type: git
  location: https://github.com/bjoernlenz/connector.git
