#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
export connector_datadir="$(pwd)"
if [ -d .tools/jdk ]; then export JAVA_HOME="$(pwd)/.tools/jdk"; fi
if [ -f .cache/bridge-classpath ]; then
  export DATOMIC_CONNECTOR_CLASSPATH="${DATOMIC_CONNECTOR_CLASSPATH:-$(cat .cache/bridge-classpath)}"
elif [ -x .tools/clojure/clojure ]; then
  export DATOMIC_CONNECTOR_CLOJURE="$(pwd)/.tools/clojure/clojure"
fi
# Every run has its own durable database; retain it for manual inspection.
DATABASE="acceptance-$(date +%Y%m%d-%H%M%S)-$$"
STORAGE="$(pwd)/data"
SYSTEM=first-contact
KEY=hello-from-haskell
cabal build --offline --build-summary=.cache/cabal-build.log all
cabal test --offline --build-summary=.cache/cabal-build.log connector-tests --test-show-details=direct
BIN=$(cabal list-bin first-contact)
TEST_BIN=$(cabal list-bin connector-tests)
scripts/bridge provision "$STORAGE" "$SYSTEM" "$DATABASE" experiment/schema.edn experiment/identities.edn
"$BIN" write "$STORAGE" "$SYSTEM" "$DATABASE" "$KEY"
# The prior Haskell and JVM processes have both exited before this new pair starts.
"$BIN" read "$STORAGE" "$SYSTEM" "$DATABASE" "$KEY"
"$TEST_BIN" --scalars scripts/bridge "$STORAGE" "$SYSTEM" "$DATABASE"
python3 test/runtime.py "$STORAGE" "$SYSTEM" "$DATABASE"
python3 experiment/refusal.py "$STORAGE" "$SYSTEM" "$DATABASE"
LOG=$(mktemp)
trap 'rm -f "$LOG"' EXIT
if cabal exec -- ghc -fno-code -package connector experiment/MissingContext.hs > "$LOG" 2>&1; then
  echo 'FAIL: anonymous Haskell write compiled' >&2; exit 1
fi
if ! rg -q WriteContext "$LOG"; then cat "$LOG"; exit 1; fi
echo 'PASS: Haskell refuses a missing WriteContext at compile time'
echo "PASS: acceptance including process restart; database $DATABASE in $STORAGE/$SYSTEM"
