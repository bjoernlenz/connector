#!/usr/bin/env python3
"""Build a relocatable bridge directory from resolved dependency jars."""
import argparse
import glob
import hashlib
import os
from pathlib import Path
import re
import shutil
import subprocess

root = Path(__file__).resolve().parent.parent
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("destination", type=Path, help="new output directory")
parser.add_argument("--classpath", help="resolved dependency classpath; defaults to env, cache, or Clojure CLI")
args = parser.parse_args()
destination = args.destination.resolve()
if destination.exists():
    parser.error("destination already exists; choose a new directory")
classpath = args.classpath or os.environ.get("DATOMIC_CONNECTOR_CLASSPATH")
if not classpath:
    cached = root / ".cache/bridge-classpath"
    if cached.exists():
        classpath = cached.read_text().strip()
    else:
        classpath = subprocess.check_output(
            [os.environ.get("DATOMIC_CONNECTOR_CLOJURE", "clojure"), "-Srepro", "-Spath"],
            cwd=root, text=True).strip()
jars = {}
for entry in classpath.split(os.pathsep):
    path = Path(entry)
    if not path.is_absolute():
        path = root / path
    for match in sorted(glob.glob(str(path))):
        jar = Path(match)
        if jar.is_file() and jar.suffix == ".jar":
            if jar.name in jars and jars[jar.name] != jar:
                parser.error(f"conflicting jar names: {jar.name}")
            jars[jar.name] = jar
if not jars:
    parser.error("no dependency jars found on the classpath")
version = re.search(r"^version:\s*(\S+)", (root / "connector.cabal").read_text(), re.M).group(1)
destination.mkdir(parents=True)
(destination / "lib").mkdir()
for name, jar in jars.items():
    shutil.copy2(jar, destination / "lib" / name)
shutil.copytree(root / "bridge/src", destination / "bridge/src")
shutil.copy2(root / "deps.edn", destination / "deps.edn")
shutil.copy2(root / "connector.cabal", destination / "connector.cabal")
(destination / "VERSION").write_text(version + "\n")
(destination / "run").write_text('''#!/bin/sh
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
JAVA=${DATOMIC_CONNECTOR_JAVA:-java}
if [ -z "${DATOMIC_CONNECTOR_JAVA:-}" ] && [ -n "${JAVA_HOME:-}" ]; then
  JAVA="$JAVA_HOME/bin/java"
fi
exec "$JAVA" -cp "$ROOT/bridge/src:$ROOT/lib/*" clojure.main -m connector.main "$ROOT/connector.cabal" "$@"
''')
(destination / "run").chmod(0o755)
files = sorted(path for path in destination.rglob("*") if path.is_file())
(destination / "SHA256SUMS").write_text("".join(
    f"{hashlib.sha256(path.read_bytes()).hexdigest()}  {path.relative_to(destination)}\n" for path in files))
print(f"Packaged connector {version}: {len(jars)} jars in {destination}")
